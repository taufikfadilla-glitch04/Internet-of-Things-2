    {
        "id": "1eb2681a9e78fae2",
        "type": "function",
        "z": "e3cfed5d2479eef8",
        "name": "function 1",
        "func": "// ===== Filter Histeresis (Bang-Bang dengan Dead Band) =====\nconst BATAS_ATAS = 31.5;   // LED ON  jika suhu > 31.5\nconst BATAS_BAWAH = 30.0;   // LED OFF jika suhu < 30.0\nconst TOPIK_KENDALI = \"kampus/labiot/kendali\";\n\n// Validasi data masuk\nif (!msg.payload || msg.payload.suhu === undefined) {\n    node.warn(\"Payload tidak memiliki field 'suhu'\");\n    return null;\n}\nconst suhu = parseFloat(msg.payload.suhu);\nif (isNaN(suhu)) {\n    node.warn(\"Nilai suhu tidak valid\");\n    return null;\n}\n\n// Ambil state LED terakhir; jika belum ada, sinkronkan dengan status_led dari NodeMCU\nlet ledState = context.get(\"ledState\");\nif (ledState === undefined) {\n    ledState = (msg.payload.status_led === 1) ? 1 : 0;\n}\n\n// Logika histeresis\nif (suhu > BATAS_ATAS) {\n    ledState = 1;            // terlalu panas -> ON\n} else if (suhu < BATAS_BAWAH) {\n    ledState = 0;            // sudah cukup dingin -> OFF\n}\n// 30.0 <= suhu <= 31.5 : zona mati, state TIDAK berubah\n\ncontext.set(\"ledState\", ledState);\n\n// Indikator status di bawah node\nnode.status({\n    fill: ledState ? \"red\" : \"green\",\n    shape: \"dot\",\n    text: \"suhu \" + suhu + \" C | LED \" + (ledState ? \"ON\" : \"OFF\")\n});\n\n// Kirim perintah ke topik kendali\nreturn {\n    topic: TOPIK_KENDALI,\n    payload: { led: ledState }\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 120,
        "y": 280,
        "wires": [
            [
                "5ca72e3b60120a16"
            ]
        ]
    }
